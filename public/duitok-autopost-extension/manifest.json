{
  "manifest_version": 3,
  "name": "Duitok Auto Post",
  "description": "Pull Duitok scheduled posts into TikTok upload pages and assist with caption filling.",
  "version": "0.1.0",
  "action": {
    "default_title": "Duitok Auto Post",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://www.tiktok.com/tiktokstudio/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:*/*",
    "https://*.duitok.com/*",
    "https://www.tiktok.com/*"
  ]
}
