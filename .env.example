PORT=4173
PUBLIC_APP_URL=http://localhost:4173
VITE_API_BASE_URL=
CORS_ORIGINS=http://localhost:4173
SERVE_STATIC=true
DATA_DIR=./data

# Future managed services. Use these when moving from local JSON storage
# to Postgres and background jobs.
DATABASE_URL=
REDIS_URL=

# From CHIP dashboard
CHIP_API_TOKEN=replace_with_chip_api_token
CHIP_BRAND_ID=replace_with_chip_brand_id

# Optional in local dev, required for production-grade callback verification.
# Paste PEM as one line, using \n between lines.
CHIP_PUBLIC_KEY=
