PORT=4173
PUBLIC_APP_URL=https://pokaya.ai
VITE_API_BASE_URL=
CORS_ORIGINS=https://pokaya.ai,https://www.pokaya.ai
SERVE_STATIC=true
DATA_DIR=./data
AUTH_SECRET=replace_with_long_random_secret
AUTH_TOKEN_TTL_MS=604800000
ADMIN_USER_IDS=u_1
ADMIN_EMAILS=admin@pokaya.ai
ADMIN_API_KEY=replace_with_private_admin_unlock_key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pokaya.ai/api/auth/google/callback
USER_GENERATE_PER_MINUTE=3
USER_GENERATE_PER_DAY=50

# Supabase Postgres. Leave empty for local JSON storage.
# Example: postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# Keep POSTGRES_SSL=true instead of adding sslmode=require to the URL.
DATABASE_URL=
POSTGRES_SSL=true
REDIS_URL=

# From CHIP dashboard
CHIP_API_TOKEN=replace_with_chip_api_token
CHIP_BRAND_ID=replace_with_chip_brand_id

# Optional in local dev, required for production-grade callback verification.
# Paste PEM as one line, using \n between lines.
CHIP_PUBLIC_KEY=

# From APIMart dashboard. Keep this server-side only.
APIMART_API_KEY=replace_with_apimart_api_key
APIMART_BASE_URL=https://api.apimart.ai
APIMART_CHAT_PATH=/v1/chat/completions
APIMART_IMAGE_PATH=/v1/images/generations
APIMART_TASK_PATH_PREFIX=/v1/tasks
APIMART_TEXT_MODEL=gpt-5-mini
APIMART_IMAGE_MODEL=gpt-image-2
APIMART_SEEDREAM_5_LITE_MODEL=seedream-5.0-lite
APIMART_SEEDREAM_4_5_MODEL=seedream-4.5
APIMART_QWEN_IMAGE_2_MODEL=qwen-image-2.0
APIMART_NANO_BANANA_PRO_MODEL=gemini-3-pro-image-preview
APIMART_NANO_BANANA_2_MODEL=gemini-3.1-flash-image-preview
APIMART_GROK_IMAGE_MODEL=grok-imagine-1.0-apimart
APIMART_SEEDANCE_MODEL=doubao-seedance-2.0
APIMART_SEEDANCE_SIZE=9:16
APIMART_SEEDANCE_RESOLUTION=1080p
APIMART_SEEDANCE_DURATION=4
APIMART_SEEDANCE_MIN_DURATION=4
APIMART_SEEDANCE_MAX_DURATION=15
APIMART_SEEDANCE_GENERATE_AUDIO=true
APIMART_GROK_VIDEO_MODEL=grok-imagine-1.0-video-apimart
APIMART_GROK_VIDEO_SIZE=16:9
APIMART_GROK_VIDEO_QUALITY=480p
APIMART_GROK_VIDEO_DURATION=6
APIMART_WAN_VIDEO_MODEL=wan2.7
APIMART_WAN_VIDEO_SIZE=16:9
APIMART_WAN_VIDEO_RESOLUTION=1080P
APIMART_WAN_VIDEO_DURATION=8
APIMART_KLING_OMNI_MODEL=kling-v3-omni
APIMART_KLING_OMNI_MODE=std
APIMART_KLING_OMNI_ASPECT_RATIO=16:9
APIMART_KLING_OMNI_DURATION=5
APIMART_KLING_OMNI_AUDIO=false
APIMART_KLING_MOTION_MODEL=kling-v3-motion-control
APIMART_KLING_MOTION_MODE=std
APIMART_KLING_MOTION_IMAGE_URL=
APIMART_KLING_MOTION_VIDEO_URL=
APIMART_KLING_MOTION_CHARACTER_ORIENTATION=image
APIMART_KLING_MOTION_KEEP_ORIGINAL_SOUND=yes
APIMART_KLING_MOTION_WATERMARK=false
APIMART_HAILUO_2_3_MODEL=MiniMax-Hailuo-2.3
APIMART_HAILUO_2_3_DURATION=6
APIMART_HAILUO_2_3_RESOLUTION=768p
APIMART_HAILUO_2_3_PROMPT_OPTIMIZER=true
APIMART_HAILUO_2_3_FAST_PRETREATMENT=false
APIMART_HAILUO_2_3_WATERMARK=false
APIMART_HAILUO_2_3_FIRST_FRAME_IMAGE=
APIMART_IMAGE_SIZE=1:1
APIMART_IMAGE_RESOLUTION=1K

# From GRS AI. Used for primary GPT Image 2, Nano Banana Pro, and Nano Banana 2 image generation.
GRSAI_API_KEY=replace_with_grsai_api_key
GRSAI_BASE_URL=https://grsaiapi.com
GRSAI_DRAW_PATH=/v1/draw/nano-banana
GRSAI_RESULT_PATH=/v1/draw/result
GRSAI_GPT_IMAGE_2_MODEL=gpt-image-2
GRSAI_GPT_IMAGE_2_VIP_MODEL=gpt-image-2-vip
GRSAI_NANO_MODEL=nano-banana-pro
GRSAI_NANO_BANANA_2_MODEL=nano-banana-2
GRSAI_CLONE_MODEL=gemini-3-pro
GRSAI_NANO_ASPECT_RATIO=1:1
GRSAI_NANO_IMAGE_SIZE=1K
GRSAI_IMAGE_POLL_ATTEMPTS=36
GRSAI_IMAGE_POLL_MS=3000

# From 302.AI. Used for MiniMax Speech text-to-speech and Suno music generation.
AI302_API_KEY=replace_with_302ai_api_key
AI302_BASE_URL=https://api.302.ai
AI302_MINIMAX_SPEECH_PATH=/minimaxi/v1/t2a_v2
AI302_MINIMAX_SPEECH_MODEL=speech-2.8-hd
AI302_MINIMAX_SPEECH_VOICE_ID=male-qn-qingse
AI302_MINIMAX_SPEECH_LANGUAGE_BOOST=auto
AI302_MINIMAX_SPEECH_SAMPLE_RATE=32000
AI302_MINIMAX_SPEECH_BITRATE=128000
AI302_ELEVEN_TTS_MULTILINGUAL_PATH=/302/submit/elevenlabs/tts-multilingual-v2-sync
AI302_ELEVEN_TTS_MULTILINGUAL_VOICE=Aria
AI302_DOUBAO_TTS_HD_PATH=/doubao/tts_hd
AI302_DOUBAO_TTS_HD_VOICE=zh_male_M392_conversation_wvae_bigtts
AI302_SUNO_SUBMIT_PATH=/suno/submit/music
AI302_SUNO_LYRICS_PATH=/suno/submit/lyrics
AI302_SUNO_FETCH_PATH_PREFIX=/suno/fetch
AI302_SUNO_MODEL=chirp-crow
AI302_AUDIO_TRANSLATE_PATH=/302/audio/translate/task

# From DeepSeek official API. Keep this server-side only.
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_PATH=/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
WEB_SEARCH_BASE_URL=https://duckduckgo.com/html/
WEB_SEARCH_TIMEOUT_MS=12000

# From TikTok for Developers. Required for official Content Posting API.
TIKTOK_CLIENT_KEY=replace_with_tiktok_client_key
TIKTOK_CLIENT_SECRET=replace_with_tiktok_client_secret
TIKTOK_AUTH_BASE_URL=https://www.tiktok.com
TIKTOK_OPEN_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_REDIRECT_PATH=/api/tiktok/oauth/callback
TIKTOK_SCOPES=user.info.basic,video.publish

# From Crun AI. Used for Veo 3.1 video generation.
CRUN_API_KEY=replace_with_crun_api_key
CRUN_BASE_URL=https://api.crun.ai
CRUN_CREATE_TASK_PATH=/api/v1/client/job/CreateTask
CRUN_TASK_INFO_PATH=/api/v1/client/job/TaskInfo
CRUN_SEEDREAM_5_MODEL=bytedance/seedream-5
CRUN_SEEDREAM_5_ENHANCE_PROMPT=false
CRUN_SEEDREAM_5_OUTPUT_FORMAT=jpeg
CRUN_VEO_3_1_MODEL=google/veo3-1-fast-t2v
CRUN_VEO_3_1_ASPECT_RATIO=9:16
CRUN_VEO_3_1_FORCE_ASPECT_RATIO=
CRUN_VEO_3_1_DURATION=8
CRUN_POLL_ATTEMPTS=60
CRUN_POLL_MS=5000
CRUN_TIMEOUT_MS=120000

# From 速创API / 无垠科技. Used for Sora 2, Gemini Omni, and voice clone.
WUYIN_API_KEY=replace_with_wuyin_api_key
WUYIN_BASE_URL=https://api.wuyinkeji.com
WUYIN_VOICE_CLONE_PATH=/api/voice/clone
WUYIN_IMAGE_SIZE=1K
WUYIN_IMAGE_ASPECT_RATIO=1:1
WUYIN_VIDEO_RATIO=9:16
WUYIN_SORA_ASPECT_RATIO=9:16
WUYIN_SORA_DURATION=8
WUYIN_SORA_SIZE=small
WUYIN_OMNI_DURATION=10
WUYIN_OMNI_FORCE_SIZE=

# Atlas Cloud. Used only for Seedance 2.0 video generation.
ATLASCLOUD_API_KEY=replace_with_atlascloud_api_key
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai
ATLASCLOUD_GENERATE_VIDEO_PATH=/api/v1/model/generateVideo
ATLASCLOUD_PREDICTION_PATH_PREFIX=/api/v1/model/prediction
ATLASCLOUD_SEEDANCE_MODEL=bytedance/seedance-2.0/text-to-video
ATLASCLOUD_SEEDANCE_DURATION=4
ATLASCLOUD_SEEDANCE_ASPECT_RATIO=9:16
ATLASCLOUD_SEEDANCE_FPS=24
ATLASCLOUD_SEEDANCE_WATERMARK=false
ATLASCLOUD_POLL_ATTEMPTS=60
ATLASCLOUD_POLL_MS=5000
ATLASCLOUD_TIMEOUT_MS=120000

# Required in production: generated assets must be mirrored before delivery.
ASSET_STORAGE_PROVIDER=r2
REQUIRE_DURABLE_ASSETS=true
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
